NODE_ENV=production
PORT=4000
TRUST_PROXY=1

DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/clinicrdv?sslmode=verify-full

JWT_SECRET=
OTP_SECRET=
FILE_URL_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30
SESSION_MAX_DAYS=90

EMAIL_DRIVER=brevo
BREVO_API_KEY=
BREVO_SENDER_EMAIL=

SMS_DRIVER=smsgate
SMSGATE_URL=https://api.sms-gate.app/3rdparty/v1
SMSGATE_USERNAME=
SMSGATE_PASSWORD=
SMS_DAILY_CAP=200
SMS_PER_NUMBER_DAILY=5

RATE_LIMIT_ENABLED=true
CORS_ORIGINS=

REMINDERS_ENABLED=true
REMINDER_INTERVAL_MINUTES=5

STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=/srv/clinicrdv/storage
PUBLIC_API_URL=https://DOMAINE

BACKUP_ENCRYPTION_KEY=
BACKUP_DIR=/srv/clinicrdv/backups
PG_DUMP_PATH=/usr/lib/postgresql/18/bin/pg_dump
PG_RESTORE_PATH=/usr/lib/postgresql/18/bin/pg_restore
RESTORE_DATABASE_URL=
