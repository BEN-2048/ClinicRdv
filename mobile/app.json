{
  "expo": {
    "name": "ClinicRDV",
    "slug": "clinicrdv",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "android": {
      "package": "com.clinicrdv.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#004AC6"
      },
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-font",
      "expo-sqlite",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "ClinicRDV utilise Face ID pour protéger votre fiche d’urgence hors ligne."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "ClinicRDV utilise votre position uniquement sur l’écran Urgence, pour trouver les services d’urgence les plus proches."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "34c00a6c-29ec-427a-8398-3af282824660"
      }
    },
    "owner": "benus"
  }
}
